__pycache__/
*.py[cod]
official_mod/bin/
official_mod/obj/
data/official_autoslay.log
.claude/
.codex/

data/*_visible_trace.jsonl
*_runner.log
*_runner.err
*_errors.log
*_result.json
data/map_*.json
!data/enemies_*.json
!data/map_*_overgrowth.json
!data/map_*_underdocks.json

# every log-ish file at any level: game/mod stdout, agent stderr, sweep runner logs.
# The pinned fixtures read by test_official_trace.py (data/*.jsonl) are traces, not logs,
# and stay tracked.
*.log
*.err
*.out
logs/

# ad-hoc official-run artifacts (game log / agent trace / map dump) that don't
# use the run_simN.ps1 naming convention above but are the same kind of
# regenerable experiment output, not something to commit.
data/*.log
data/*_map_ACT.*.json
data/*_log.txt
data/*_trace.jsonl
data/*_agent.jsonl
data/*_map.json
data/*_mapdebug.jsonl
data/dashboard.html
data/dashboard_gen.log
data/*_observations.jsonl
data/*.err
# the same output written under a per-run subdirectory (panel arms live there)
data/**/*_agent.jsonl
data/**/*.log
data/**/*_map.json

# measurement helpers: the run scripts and the recorded decision they replay. The panel
# artifacts they read (traces, results, logs) are already ignored above, so these stay out to
# keep a run reproducible-only.
data/sweep*.sh
data/replay_*.json

# detached worktrees that hold a same-commit baseline for A/B measurement
.wt-*/

# leftover artifact of a write-permission probe, not repo content
*_write_test_*.txt
